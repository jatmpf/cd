  function makePanelMovable() {
    const panel = $('#cdca-panel'), handle = $('#cdca-panel-head');
    const saved = GM_getValue(PANEL_KEY, null);
    if (saved) { panel.style.left = `${saved.left}px`; panel.style.top = `${saved.top}px`; panel.style.right = 'auto'; }
    let dragging = false, offsetX = 0, offsetY = 0;
    handle.addEventListener('pointerdown', event => {
      if (event.target.closest('button')) return;
      dragging = true; offsetX = event.clientX - panel.offsetLeft; offsetY = event.clientY - panel.offsetTop;
      handle.setPointerCapture(event.pointerId);
    });
    handle.addEventListener('pointermove', event => {
      if (!dragging) return;
      panel.style.left = `${Math.max(0, Math.min(innerWidth - panel.offsetWidth, event.clientX - offsetX))}px`;
      panel.style.top = `${Math.max(0, Math.min(innerHeight - 42, event.clientY - offsetY))}px`;
      panel.style.right = 'auto';
    });
    handle.addEventListener('pointerup', event => {
      if (!dragging) return; dragging = false; handle.releasePointerCapture(event.pointerId);
      GM_setValue(PANEL_KEY, { left: panel.offsetLeft, top: panel.offsetTop });
    });
  }

